   "version": 1,
   "versionNonce": 1142906606,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Dismiss on the preview card does NOT change the state.\nIt marks the result as seen: the icon stays, the bounce stops.\nA new state makes it news again.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "Dismiss on the preview card does NOT change the state.\nIt marks the result as seen: the icon stays, the bounce stops.\nA new state makes it news again.",
   "lineHeight": 1.25,
   "autoResize": true
  },
