   "seed": 135167323,
   "version": 1,
   "versionNonce": 1915822735,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "From ANY state: session_end (clean exit) or process gone\n(terminal killed) moves a session to ended. Process gone also\nraises the 'ended unexpectedly' notification.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "From ANY state: session_end (clean exit) or process gone\n(terminal killed) moves a session to ended. Process gone also\nraises the 'ended unexpectedly' notification.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "n2",
   "type": "text",
   "x": 40,
