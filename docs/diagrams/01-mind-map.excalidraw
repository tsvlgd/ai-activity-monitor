   "locked": false,
   "text": "1  INPUT: the agents report\n\nClaude Code: a hook script runs on\nevery event, JSON arrives on stdin\nOpenCode: a plugin listens to the\nserver's internal event stream",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 15,
   "containerId": "in",
   "originalText": "1  INPUT: the agents report\n\nClaude Code: a hook script runs on\nevery event, JSON arrives on stdin\nOpenCode: a plugin listens to the\nserver's internal event stream",
   "lineHeight": 1.25,
   "autoResize": true
  },
