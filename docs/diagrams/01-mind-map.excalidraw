   "updated": 1,
   "link": null,
   "locked": false,
   "text": "3  BRAIN: pure logic\n\nEvents become session states:\nidle, working, waiting, completed,\nerror, ended. Decides what to show\nand when to notify",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 15,
   "containerId": "br",
   "originalText": "3  BRAIN: pure logic\n\nEvents become session states:\nidle, working, waiting, completed,\nerror, ended. Decides what to show\nand when to notify",
   "lineHeight": 1.25,
   "autoResize": true
  },
