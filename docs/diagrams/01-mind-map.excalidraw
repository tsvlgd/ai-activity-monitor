   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2  TRANSPORT: files in RAM\n\nOne small JSON line per event in\n$XDG_RUNTIME_DIR/ai-activity-monitor\nThe kernel tells us when a file\nchanges (inotify). No network",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 15,
   "containerId": "tr",
   "originalText": "2  TRANSPORT: files in RAM\n\nOne small JSON line per event in\n$XDG_RUNTIME_DIR/ai-activity-monitor\nThe kernel tells us when a file\nchanges (inotify). No network",
   "lineHeight": 1.25,
   "autoResize": true
  },
