---
// The preview card from lib/ui/preview.js, rebuilt in HTML with the values
// of the extension's stylesheet.css.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
interface Props { notch?: boolean }
const {notch = false} = Astro.props;
---
<figure class:list={['card', {notched: notch}]} aria-label="GlanceAgent preview card for a Claude Code session that needs approval">
  <div class="card-head">
    <span class="tile card-tile"><img src={`${base}logos/claude-code.svg`} alt="" width="24" height="24" /></span>
    <div class="card-title">
      <b>Claude Code</b>
      <small><span class="dot" style="background: var(--waiting)"></span>auth-service · 1m</small>
    </div>
    <span class="chip">Needs you</span>
  </div>
  <p class="card-current">Approve: Edit session.ts</p>
  <div class="log" aria-label="Recent activity">
    <span>Read src/auth/session.ts</span>
    <span>Update src/auth/session.ts</span>
    <span class="warn">Waiting for your approval</span>
  </div>
  <div class="card-actions" aria-hidden="true">
    <span class="card-btn primary">Open in Terminal</span>
    <span class="card-btn">Dismiss</span>
  </div>
</figure>

<style>
  /* The card keeps its light product colours in dark mode too: it is a
     picture of the GNOME UI, framed as one. */
  .card {
    position: relative; width: 100%; max-width: 460px;
    background: rgba(246, 247, 250, 0.98); color: #262a33;
    border: 1px solid rgba(24, 30, 42, 0.07); border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 20px 20px 18px;
  }
  .card.notched::before {
    content: ""; position: absolute; top: -7px; right: var(--notch-right, 112px);
    width: 14px; height: 14px; background: rgba(246, 247, 250, 0.98);
    border-left: 1px solid rgba(24, 30, 42, 0.07); border-top: 1px solid rgba(24, 30, 42, 0.07);
    transform: rotate(45deg); border-top-left-radius: 3px;
  }
  .card-head { display: flex; align-items: center; gap: 12px; }
  .card-tile { box-shadow: none; background: #ffffff; width: 42px; height: 42px; }
  .card-title { min-width: 0; }
  .card-title b { display: block; font-size: 1.0625rem; line-height: 1.3; color: #20242c; }
  .card-title small { display: flex; align-items: center; gap: 6px; font-size: 0.8125rem; color: #5f6672; }
  .card-title .dot { width: 6px; height: 6px; }
  .chip { margin-left: auto; flex: none; font-size: 0.78rem; font-weight: 700; border-radius: 11px; padding: 4px 11px; color: #87560f; background: rgba(223, 154, 60, 0.2); }
  .card-current { margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(43, 48, 59, 0.08); font-weight: 600; font-size: 0.95rem; }
  .log { display: grid; gap: 2px; margin-top: 10px; background: #23272f; color: #d5dae3; border-radius: 12px; padding: 12px 14px; font-family: var(--mono); font-size: 0.78rem; line-height: 1.65; overflow: hidden; }
  .log span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .log .warn { color: #f0c27a; }
  .card-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 14px; }
  .card-btn { text-align: center; border-radius: 12px; padding: 11px 8px; font-weight: 650; font-size: 0.9rem; background: rgba(120, 130, 145, 0.13); color: #262a33; white-space: nowrap; }
  .card-btn.primary { background: #2b303b; color: #ffffff; }
</style>
